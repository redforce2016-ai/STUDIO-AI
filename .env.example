# کلید پیش‌فرض Gemini (یا کلید اصلی استودیو) — به صورت خودکار توسط سرور تزریق می‌شود
GEMINI_API_KEY=

# کلیدهای اختصاصی ۱۰ اکانت جیمیل مرورگر ایجنت (تولیدشده از Google AI Studio هر اکانت)
# با تنظیم این متغیرها در Settings > Secrets یا فایل .env سرور، کلیدها با ریستارت حفظ می‌شوند
# و در صورت محدودیت سهمیه (429) روتر به صورت خودکار و بدون خطا به اکانت بعدی سوییچ می‌کند:
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=
GEMINI_API_KEY_5=
GEMINI_API_KEY_6=
GEMINI_API_KEY_7=
GEMINI_API_KEY_8=
GEMINI_API_KEY_9=
GEMINI_API_KEY_10=

# سرویس‌های رایگان اختیاری برای روتر چندمدلی (OpenRouter :free، Groq، Cerebras و ...)
OPENROUTER_API_KEY=
GROQ_API_KEY=
CEREBRAS_API_KEY=
MISTRAL_API_KEY=
HUGGINGFACE_API_KEY=

# تنظیمات اختیاری اتوماسیون محلی DaVinci Resolve در نسخه دسکتاپ ویندوز
RESOLVE_SCRIPT_API=C:\\ProgramData\\Blackmagic Design\\DaVinci Resolve\\Support\\Developer\\Scripting
